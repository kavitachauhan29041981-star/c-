
#include <stdio.h>
int main()
{
    int n;
    printf("enter number of rows = ");
    scanf("%d", &n);
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= n - i; j++) // left spaces
        {
            printf(" ");
        }
        for (int k = 1; k <= i; k++) // middle star triangle
        {
            printf("*");
        }
        for (int k = 1; k <= n - i; k++) // right stars
        {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
